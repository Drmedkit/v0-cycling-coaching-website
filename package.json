{
  "name": "tycho-coaching",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "check": "pnpm lint && pnpm typecheck && pnpm check:content",
    "check:content": "tsx scripts/validate-content.ts",
    "dev": "next dev",
    "lint": "eslint app components lib scripts middleware.ts --max-warnings=0",
    "start": "next start",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "15.5.20",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.20",
    "postcss": "8.5.19",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "8.5.19",
      "yaml@>=2.0.0 <2.8.3": "2.9.0"
    }
  }
}
